# Defaults to ~/youtube-ai-pipeline/docker/.env when that file exists.
# LLM_ENV_FILE=/path/to/shared/.env
LLM_PROVIDER_ORDER=groq,gemini
# Rate-limit waiting (seconds): retry a busy provider before falling back.
# LLM_RETRY_ROUNDS=3
# LLM_BACKOFF_BASE=5
# LLM_MAX_WAIT=60
LLM_GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
LLM_GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.5-flash-lite
GROQ_API_KEY_MOTIVATION=
GROQ_API_KEY_DAILY_CURIOSITY=
GROQ_API_KEY_ANIMAL_MICRODRAMA=
GEMINI_API_KEY_MOTIVATION=
GEMINI_API_KEY_ANIMAL_MICRODRAMA=
GEMINI_API_KEY=
APP_NAME=
APP_TAGLINE=
# QUOTE_FONT=/path/to/japanese-font.ttc
